# Configuración de ZombieBot

# Codec de video (h264_nvenc para NVIDIA, libx264 para CPU)
VIDEO_CODEC=h264_nvenc

# Ruta al perfil de Chrome (opcional, para subidas automáticas)
# Windows ejemplo: C:\Users\NombreUsuario\AppData\Local\Google\Chrome\User Data
# Linux ejemplo: /home/usuario/.config/google-chrome/Default
CHROME_PROFILE_PATH=
